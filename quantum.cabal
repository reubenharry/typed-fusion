cabal-version:      3.0
name:               quantum
version:            0.1.0.0
license:            BSD-3-Clause
license-file:       LICENSE
author:             =
maintainer:         reubenharry@gmail.com
category:           Math
build-type:         Simple
extra-doc-files:    CHANGELOG.md

common warnings
    ghc-options: -Wall

library
    import:           warnings
    exposed-modules:
        -- Constrained category classes + Vect morphisms
        Categorical.Bifunctor
        Categorical.Associative
        Categorical.Monoidal
        Categorical.Braided
        Categorical.CompactClosed
        Categorical.Linear
        -- Fusion theories (incl. Fibonacci)
        Fusion.Theory
        Fusion.Obj
        Fusion.Hom
        Fusion.Data
        Fusion.Ops
        Fusion.Unbounded
        Fusion.SU2
        Fusion.U1
        Fusion.Fibonacci
        -- HomUnfused / HomFused / HomInter (group-indexed; SU(2)+U(1))
        Hom
        Hom.Expr
        Hom.TypeLevel
        Hom.Singletons
        Hom.FTreeV
        Hom.FMove
        Hom.Core
        Hom.Action
        Hom.Arbitrary
        Hom.Pretty
        Hom.Smoke
        Hom.Reference
        Examples.Symbolic
        Hom.Vec
        -- SU(2) CG / type-level helpers
        Symmetry.Utils
        Symmetry.Group
        Symmetry.SU2
        Symmetry.Tensor
        Symmetry.CG.SU2
    hs-source-dirs:   src
    default-language: Haskell2010
    build-depends:
        base ^>=4.19.2.0,
        linearmap-category >= 0.6 && < 0.7,
        linearmap-hmatrix >= 0.1 && < 0.2,
        free-vector-spaces,
        lens,
        adjunctions,
        singletons,
        singletons-th ^>=3.3,
        transformers,
        random,
        linear,
        ieee754,
        vector-space,
        containers,
        constrained-categories,
        manifolds-core,
        QuickCheck,
        hmatrix,
        vector,
        vector-sized,
        indexed-list-literals,
        finite-typelits,
        ghc-typelits-knownnat,
        mtl

test-suite quantum-test
    import:           warnings
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test
    main-is:          Main.hs
    default-language: GHC2021
    build-depends:
        base ^>=4.19.2.0,
        quantum,
        QuickCheck
